\idaShort{Osobowość a preferencje przestrzenne}{Osobowość}
\idaShort{Metodologia badań}{Metodologia}
\idaShort{Artefakt badawczy IDA --- koncepcja, budowa i uzasadnienie projektowe}{Artefakt IDA}
\idaShort{Wyniki badań}{Wyniki}
\idaShort{Dyskusja}{Dyskusja}
\idaShort{Wnioski końcowe}{Wnioski}
\idaShort{Schemat bazy danych badawczych}{Schemat bazy}
\idaShort{Treść instrumentów i ekranów}{Instrumenty}
\idaShort{Mapowanie podwymiarów cech na parametry promptu}{Mapowanie podwymiarów cech}
