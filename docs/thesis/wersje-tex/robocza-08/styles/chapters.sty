% Purpose: chapter openers, short running heads, and section hierarchy.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/chapters}[2026/10/05 IDA thesis chapter system]

\RequirePackage[pagestyles,nobottomtitles*]{titlesec}
\RequirePackage{etoolbox}

\newif\ifida@front
\newif\ifida@appendix
\ida@fronttrue

\makeatletter
% Full title (as written in the chapter file) -> short running head.
% TOC and the printed \chapter title stay untouched.
\newcommand{\idaShort}[2]{%
  \expandafter\gdef\csname ida@short@\detokenize{#1}\endcsname{#2}%
}

